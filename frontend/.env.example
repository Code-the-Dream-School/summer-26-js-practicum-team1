# Leave empty to use the Vite dev proxy (/api -> http://localhost:8080).
# Or set explicitly, e.g. VITE_API_URL=http://localhost:8080
VITE_API_URL=

# Required for location autocomplete (help requests, browse filters).
# Get a key at https://www.geoapify.com/ and restrict it to your dev domain.
VITE_GEOAPIFY_API_KEY=
