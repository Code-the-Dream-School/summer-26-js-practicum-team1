generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum Role {
  REQUESTER
  VOLUNTEER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Category {
  GROCERY
  TRANSPORTATION
  HOUSEHOLD_CHORES
  YARD_WORK
  PET_CARE
  TECH_SUPPORT
  COMPANIONSHIP
  MEAL_PREP
  MEDICAL_ERRAND
  OTHER
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum VolunteerResponseAction {
  ACCEPTED
  DECLINED
}

enum NotificationType {
  HELP_REQUEST_ACCEPTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  SKIPPED
}

// USERS

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique @db.VarChar(255)
  name                String    @db.VarChar(100)
  passwordHash        String    @map("hashed_password") @db.VarChar(255)
  role                Role      @default(REQUESTER)
  phone               String?   @db.VarChar(20)
  createdAt           DateTime  @default(now()) @map("created_at")
  dob                 DateTime
  gender              Gender
  profileImage        Bytes?    @map("profile_image")
  profileImageType    String?   @map("profile_image_type")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  volunteerProfile VolunteerProfile?
  requesterProfile RequesterProfile?

  volunteerVerifications VolunteerVerification[] @relation("Reviewer")
  helpRequests           HelpRequest[]
  sentMessages           Message[]
  notifications          Notification[]

  @@map("users")
}

model VolunteerProfile {
  userId             Int                @id
  bio                String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  verifications     VolunteerVerification[]
  availability      Json?
  serviceArea       String?                 @map("service_area") @db.VarChar(255)
  serviceLatitude   Float?                  @map("service_latitude")
  serviceLongitude  Float?                  @map("service_longitude")
  supportCategories UserSupportCategory[]
  helpRequests      HelpRequest[]
  responses         VolunteerResponse[]

  @@index([serviceArea])
  @@index([verificationStatus])
  @@map("volunteer_profiles")
}

model VolunteerVerification {
  id          Int                @id @default(autoincrement())
  volunteerId Int
  status      VerificationStatus
  reviewedBy  Int?
  reviewedAt  DateTime           @default(now())
  notes       String?
  volunteer   VolunteerProfile   @relation(fields: [volunteerId], references: [userId], onDelete: Cascade)

  reviewer User? @relation("Reviewer", fields: [reviewedBy], references: [id])

  @@map("volunteer_verifications")
}

model HelpRequest {
  id                 Int           @id @default(autoincrement())
  requesterId        Int
  volunteerId        Int?
  title              String        @db.VarChar(100)
  category           Category
  urgency            Urgency
  scheduledAt        DateTime
  scheduledDayOfWeek Int           @default(dbgenerated())
  address            String
  latitude           Float
  longitude          Float
  description        String?
  status             RequestStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  completedAt        DateTime?
  conversation       Conversation?

  requester User                @relation(fields: [requesterId], references: [id])
  volunteer VolunteerProfile?   @relation(fields: [volunteerId], references: [userId])
  responses VolunteerResponse[]

  @@index([scheduledDayOfWeek])
}

model VolunteerResponse {
  id          Int                     @id @default(autoincrement())
  requestId   Int                     @map("request_id")
  volunteerId Int                     @map("volunteer_id")
  action      VolunteerResponseAction
  createdAt   DateTime                @default(now()) @map("created_at")

  request   HelpRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [userId], onDelete: Cascade)

  @@unique([requestId, volunteerId])
  @@index([requestId])
  @@index([volunteerId])
  @@map("volunteer_responses")
}

model RequesterProfile {
  userId           Int     @id
  address          String?
  city             String?
  bio              String?
  emergencyContact String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("requester_profiles")
}

model Conversation {
  id        Int      @id @default(autoincrement())
  requestId Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request  HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String    @db.VarChar(1000)
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model SupportCategory {
  id          Int                   @id @default(autoincrement())
  name        String                @unique @db.VarChar(100)
  description String?
  users       UserSupportCategory[]

  @@map("support_categories")
}

model UserSupportCategory {
  id                Int @id @default(autoincrement())
  volunteerId       Int @map("volunteer_id")
  supportCategoryId Int @map("support_category_id")

  volunteer       VolunteerProfile @relation(fields: [volunteerId], references: [userId], onDelete: Cascade)
  supportCategory SupportCategory  @relation(fields: [supportCategoryId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, supportCategoryId])
  @@map("user_support_categories")
}

model Notification {
  id          Int              @id @default(autoincrement())
  recipientId Int              @map("recipient_id")
  type        NotificationType
  dedupeKey   String           @unique @map("dedupe_key") @db.VarChar(120)
  payload     Json
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient  User                   @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, readAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             Int                        @id @default(autoincrement())
  notificationId Int                        @map("notification_id")
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attemptCount   Int                        @default(0) @map("attempt_count")
  lastAttemptAt  DateTime?                  @map("last_attempt_at")
  deliveredAt    DateTime?                  @map("delivered_at")
  failureReason  String?                    @map("failure_reason") @db.VarChar(500)
  createdAt      DateTime                   @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, lastAttemptAt])
  @@map("notification_deliveries")
}
