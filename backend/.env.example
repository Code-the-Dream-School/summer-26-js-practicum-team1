PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/neighborhood_helper
JWT_SECRET=your-secret-key
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID="ID HERE"
GOOGLE_CLIENT_SECRET="SECRET HERE"

# Email notifications (HELPER-144)
# log = console only (default when SENDGRID_API_KEY is unset)
# sendgrid = SendGrid HTTP API
EMAIL_DELIVERY_MODE=log
EMAIL_FROM=Neighborhood Helper <noreply@example.com>
SENDGRID_API_KEY=
